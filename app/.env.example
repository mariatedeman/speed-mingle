VITE_LINKEDIN_CLIENT_ID=
# Måste exakt matcha "Authorized redirect URL" i LinkedIn Developer Portal
VITE_LINKEDIN_REDIRECT_URI=http://localhost:5173/login
# För "Sign In with LinkedIn using OpenID Connect"
VITE_LINKEDIN_SCOPE=openid profile email
# Legacy-alternativ (om appen är konfigurerad för gamla scopes): r_liteprofile r_emailaddress